val Double TEMP_INIT_CLOSING = 27.0
val Double SUN_ELEVATION_OPENING = 20.0

// Notify current state on startup
rule "Startup"
when
    System started
then
    logInfo("RuleEngine", "Rule at system startup")
    val actions = getActions("mqtt","mqtt:broker:pshActor1")
    actions.publishMQTT("/Pi1/In/Admin","NOTIFY_CURRENT_STATE")    
end


// Switch on lights
rule "Start night lights on sunset"
when
    Channel "astro:sun:home:set#event" triggered START
then
    logInfo("Sunset Rule", "Sunset occurred, scheduling night lights ON in 30 minutes. Current Away state: {}", gNightLights.state)
    createTimer(now.plusMinutes(30), [ |
        logInfo("Sunset Rule", "Turning on night lights")
        gNightLights.sendCommand(ON)
        if (Away.state == ON) {
            logInfo("Sunset Rule", "Away mode active, turning on away lights")
            gAwayLights.sendCommand(ON)
        }
    ])
end

// Switch on Xmas lights
rule "Switch on Xmas lights"
when
    Time cron "0 0 16 6-31 DEC ? *" or
    Time cron "0 15 16 1-15 JAN ? *"
then
    gNightLights.sendCommand(OFF)
    gXmasLights.sendCommand(ON)
end

// Switch off all night lights every day at 23:00
rule "Off night lights"
when
    Time cron "0 0 23 * * ?"
then
    gNightLights.sendCommand(OFF)
    gXmasLights.sendCommand(OFF)
    gAwayLights.sendCommand(OFF)
end

// Switch off lights
rule "Switch off night lights on sunrise"
when
    Channel "astro:sun:home:rise#event" triggered START
then
    logInfo("Astro", "Sun rise occured, elevation {}, lights to be disables", Sun_Elevation.state)
    gNightLights.sendCommand(OFF)
    gXmasLights.sendCommand(OFF)
end


// Close blinds in Gabinet if today is hot (over 27°C)
// Position convention: 0% = fully open (Otwórz), 100% = fully closed (Zamknij).
rule "Zabezpieczenie przed upałem w Gabinecie"
when
    Time cron "0 0 8 * * ?" // Codziennie o 08:00 rano
then
    val tempState = Weather_Temp_Max_Today.state
    if (tempState instanceof QuantityType<?>) {
        val tempMax = (tempState as QuantityType<Number>).toUnit("°C")
        if (tempMax === null) {
            logWarn("WeatherRule", "Nie można przeliczyć Weather_Temp_Max_Today na °C (obecny stan: {}).", tempState)
        } else if (tempMax.doubleValue > TEMP_INIT_CLOSING) {
            logInfo("WeatherRule", "Prognozowana temperatura na dziś to {}°C (> {}°C). Zamykam rolety w grupie gWindowBlinds do 90%.", tempMax.doubleValue, TEMP_INIT_CLOSING)
            gWindowBlinds.sendCommand(60)
        } else {
            logInfo("WeatherRule", "Prognozowana temperatura na dziś to {}°C (<= {}°C). Rolety bez zmian.", tempMax.doubleValue, TEMP_INIT_CLOSING)
        }
    } else {
        logWarn("WeatherRule", "Stan Weather_Temp_Max_Today nie jest typu QuantityType (obecny stan: {}).", tempState)
    }
end

// Open blinds when sun is low and it was hot today
rule "Otwarcie rolet po upalnym dniu"
when
    Item Sun_Elevation changed
then
    val elevationState = Sun_Elevation.state
    if (elevationState instanceof DecimalType) {
        val elevation = (elevationState as DecimalType).doubleValue
        val prevElevationState = previousState
        val prevElevation = if (prevElevationState instanceof DecimalType) (prevElevationState as DecimalType).doubleValue else 999.0

        if (elevation < SUN_ELEVATION_OPENING && prevElevation >= SUN_ELEVATION_OPENING && now.getHour >= 13) {
            val tempState = Weather_Temp_Max_Today.state
            if (tempState instanceof QuantityType<?>) {
                val tempMax = (tempState as QuantityType<Number>).toUnit("°C")
                if (tempMax !== null && tempMax.doubleValue > TEMP_INIT_CLOSING) {
                    logInfo("WeatherRule", "Słońce nisko ({}° < {}°) i dziś było gorąco ({}°C > {}°C). Otwieram rolety w grupie gWindowBlinds.", elevation, SUN_ELEVATION_OPENING, tempMax.doubleValue, TEMP_INIT_CLOSING)
                    gWindowBlinds.sendCommand(UP)
                }
            } else {
                logWarn("WeatherRule", "Stan Weather_Temp_Max_Today nie jest typu QuantityType (obecny stan: {}).", tempState)
            }
        }
    }
end

// Scene: Working in Office
rule "Scena Praca w biurze"
when
    Item Office_Scene_Working received command ON
then
    logInfo("Scene", "Activating Working in Office scene")
    Office_Light.sendCommand(OFF)
    Office_Biurko.sendCommand(ON)
    Office_Scene_Working.postUpdate(OFF)
end

// Scene: Kino
rule "Scena Kino"
when
    Item Livingroom_Scene_Kino received command ON
then
    logInfo("Scene", "Activating Kino scene")
    gLivingroomCeilingLight.sendCommand(OFF)
    Livingroom_LedTV.sendCommand(ON)
    Livingroom_Lampa.sendCommand(ON)
    Livingroom_Scene_Kino.postUpdate(OFF)
end

